# Copy this file to ".env" and edit the values.

# --- MongoDB ---
# Option A (default): MongoDB Community Server installed on your laptop
MONGO_URI=mongodb://localhost:27017
# Option B: MongoDB Atlas (paste your own connection string, URL-encode special characters in the password)
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=campuspulse

# --- Flask ---
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=0
PORT=5000

# --- Admin account created automatically on first run ---
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@campuspulse.local
ADMIN_PASSWORD=Admin@123
